# Copy to .env and fill in to enable outgoing email for contact-form submissions.
# Submissions are always stored in server/data/submissions.json regardless of email.
PORT=8787
HOST=0.0.0.0

# SMTP settings (e.g. your mail host, Gmail app password, Mailtrap, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered / shown as sender.
CONTACT_TO=
CONTACT_FROM=
