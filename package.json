{
  "name": "kgyat-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React + Node exact clone of the Kgyat WordPress site",
  "scripts": {
    "capture": "node capture/crawl.mjs",
    "server": "node server/index.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^6.9.14"
  }
}
